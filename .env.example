# Copy to .env and fill in. Never commit .env.
# Provider: nvidia | groq | ollama | openai
LLM_PROVIDER=nvidia

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

GROQ_API_KEY=
GROQ_MODEL=qwen-2.5-32b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
